window-rule {
  draw-border-with-background false
	geometry-corner-radius 25
        clip-to-geometry true
}
window-rule {
	background-effect {
		blur true
		xray false
	}
}

// Steam
window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
}

window-rule {
	match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
	default-floating-position x=10 y=10 relative-to="bottom-right"
	open-focused false
}

// Noctolia
window-rule {
	match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
}

layer-rule {
	match namespace="^noctalia-wallpaper"
        place-within-backdrop true
}

layer-rule {
	match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
		xray false
		blur false
        }
}

// BLUR CONFIG --
window-rule {
    match is-active=false
    exclude app-id="^kitty$"

    opacity 0.95
}

window-rule {
    match is-active=true
    exclude app-id="^kitty$"
    opacity 0.95
}

// Apps

// Pip for browser
window-rule {
  match app-id=r#"zen$"# title="^Picture-in-Picture$"
  match app-id=r#"app.zen_browser.zen$"# title="^Picture-in-Picture$"
  match app-id=r#"firefox$"# title="^Picture-in-Picture$"
  match app-id=r#"librewolf$"# title="^Picture-in-Picture$"

  open-floating true
}

// Rules for xdg-desktop-portal-gtk
window-rule {
    match app-id=r#"xdg-desktop-portal-gtk"#

    open-floating true
    default-floating-position x=0 y=0
    min-width 400
    min-height 600
}
